# PYRFDC_CONFIG ROM: absolute address 0x4_0000_1000 (crossbar offset 0x1000),
# 4 KB window, magic word 0 "RFDC". roguetcpbridge reads word 0 alone first
# and only reads the remaining bytes when it is the valid magic, because on
# an old bitstream this offset aliases AxiVersion and may DECERR.
RFDC_ROM_ADDR  = 0x400001000
RFDC_ROM_SIZE  = 4096
RFDC_ROM_MAGIC = 0x52464443


def readRfdcRom(memMap):
    """Read the PYRFDC_CONFIG ROM through the given memory map.

    Reads word 0 alone; reads the remaining RFDC_ROM_SIZE-4 bytes only when
    word 0 is the valid magic. Returns b'' on any exception so the caller
    always has bytes to hand to PyRFdc.
    """
    master = rogue.interfaces.memory.Master()
    master._setSlave(memMap)

    try:
        buf0 = bytearray(4)
        txId = master._reqTransaction(RFDC_ROM_ADDR, buf0, 4, 0, rogue.interfaces.memory.Read)
        master._waitTransaction(txId)
        err = master._getError()
        if err:
            master._clearError()
            raise RuntimeError(err)

        word0 = int.from_bytes(bytes(buf0), 'little')

        if word0 != RFDC_ROM_MAGIC:
            print(f'PyRFdc config ROM: read 4 bytes at 0x{RFDC_ROM_ADDR:x}, word 0 = 0x{word0:08X}', flush=True)
            return bytes(buf0)

        rest = bytearray(RFDC_ROM_SIZE - 4)
        txId = master._reqTransaction(RFDC_ROM_ADDR + 4, rest, RFDC_ROM_SIZE - 4, 0, rogue.interfaces.memory.Read)
        master._waitTransaction(txId)
        err = master._getError()
        if err:
            master._clearError()
            raise RuntimeError(err)

        cfg = bytes(buf0) + bytes(rest)
        print(f'PyRFdc config ROM: read {len(cfg)} bytes at 0x{RFDC_ROM_ADDR:x}, word 0 = 0x{word0:08X}', flush=True)
        return cfg

    except Exception as e:
        print(f'PyRFdc config ROM read failed: {e}', flush=True)
        return b''

#################################################################

class ZynqTcpServer(object):
    def __init__(self,numLane,numDest):

        # Memory server on port [9000:9001]
        print( 'Starting Memory TcpServer at Port=9000')
        self.memMap = rogue.hardware.axi.AxiMemMap('/dev/axi_memory_map')
        self.memServer = rogue.interfaces.memory.TcpServer('*', 9000)
        self.memServer >> self.memMap

        # Data server on port [10000+512*lane+2*tdest:10000+512*lane+2*tdest+1]
        self.dmaStream = [[None] * numDest for _ in range(numLane)]
        self.dataServer = [[None] * numDest for _ in range(numLane)]
        for lane in range(numLane):
            for tdest in range(numDest):
                port = 10000+512*lane+2*tdest
                print( f'Starting Stream TcpServer at Port={port} and Port={port+1} for DMA[{lane}][{tdest}]' )
                self.dmaStream[lane][tdest] = rogue.hardware.axi.AxiStreamDma('/dev/axi_stream_dma_0', 256*lane+tdest, True)
                self.dataServer[lane][tdest] = rogue.interfaces.stream.TcpServer('*',port)
                self.dmaStream[lane][tdest] == self.dataServer[lane][tdest]

        # PyRFdc Integration
        self.apiMap = None
        self.rfdcApi = None

        try:
            import PyRFdc
            print("PyRFdc module imported successfully.")

            cfg = readRfdcRom(self.memMap)

            # Memory server on port [9002:9003]
            self.apiMap = rogue.interfaces.memory.TcpServer('*', 9002)
            self.rfdcApi = PyRFdc.PyRFdc(cfg)
            self.apiMap >> self.rfdcApi

        except (ImportError, ModuleNotFoundError):
            print("PyRFdc module is not installed.")
        except Exception as e:
            print(f"Error initializing PyRFdc: {e}")

    def __enter__(self):
        """Enable using the class as a context manager."""
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        """Shutdown when exiting the 'with' block."""
        print("Shutting down TCP servers...")
        del self.memServer
        del self.memMap
        del self.dataServer
        del self.dmaStream

        if self.apiMap:
            del self.apiMap
        if self.rfdcApi:
            del self.rfdcApi

        print("Shutdown complete.")

